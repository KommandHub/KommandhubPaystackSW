{% block sw_order_document_card %}
    {% block kommandhub_paystack_detail_card %}
    <mt-card
            position-identifier="sw-order-document-card"
            class="kommandhub-paystack-detail-card"
    >
        {% block kommandhub_paystack_detail_card_banner %}
        <div
                v-if="paystackIcon"
                class="kommandhub-paystack-detail-card__banner"
        >
            <img
                    :src="paystackIcon"
                    class="kommandhub-paystack-detail-card__icon"
                    alt="Paystack logo"
            >
            <h3 class="kommandhub-paystack-detail-card__header">
                {{ $t('kommandhub-paystack-detail.header') }}
            </h3>
        </div>
        {% endblock %}

        {% block kommandhub_paystack_detail_card_grid %}
        <template #grid>
            {% block kommandhub_paystack_detail_content %}
            <sw-data-grid
                    v-if="paystackTransaction"
                    :data-source="paystackTransactionData"
                    :columns="paystackTransactionColumns"
                    :show-selection="false"
                    :show-actions="true"
                    class="kommandhub-paystack-detail-grid"
            >
                {% block kommandhub_paystack_detail_grid_column_amount %}
                <template #column-amount="{ item }">
                    {{ currencyFilter(item.amount, item.currency) }}
                </template>
                {% endblock %}

                {% block kommandhub_paystack_detail_grid_actions %}
                <template #actions="{ item }">
                    {% block kommandhub_paystack_detail_grid_actions_refund %}
                    <sw-context-menu-item
                            @click="onOpenRefundModal(item)"
                    >
                        {{ $t('kommandhub-paystack-detail.grid.refund') }}
                    </sw-context-menu-item>
                    {% endblock %}
                </template>
                {% endblock %}

                {% block kommandhub_paystack_detail_grid_column_fee %}
                <template #column-fee="{ item }">
                    {{ currencyFilter(item.fee, item.currency) }}
                </template>
                {% endblock %}

                {% block kommandhub_paystack_detail_grid_column_state %}
                <template #column-state="{ item }">
                    <sw-label
                            v-if="item.state"
                            variant="neutral"
                            appearance="pill"
                    >
                        {{ item.state.translated.name }}
                    </sw-label>
                </template>
                {% endblock %}

                {% block kommandhub_paystack_detail_grid_column_verified_at %}
                <template #column-verifiedAt="{ item }">
                    <sw-time-ago
                            :date="item.verifiedAt"
                            :date-time-format="{ month: '2-digit', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }"
                    />
                </template>
                {% endblock %}
            </sw-data-grid>
            {% endblock %}

            {% block kommandhub_paystack_detail_empty_state %}
            <sw-empty-state
                    v-else
                    :title="$t('kommandhub-paystack-detail.emptyState.title')"
                    :subline="$t('kommandhub-paystack-detail.emptyState.subline')"
                    icon="regular-credit-card"
                    class="kommandhub-paystack-detail-empty-state"
            />
            {% endblock %}
        </template>
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block kommandhub_paystack_detail_captures_card %}
    <mt-card
            v-if="paystackCaptures.length"
            position-identifier="kommandhub-paystack-detail-captures-card"
            class="kommandhub-paystack-detail-captures-card"
            style="margin-top: 20px;"
    >
        <template #default>
            {% block kommandhub_paystack_detail_captures_grid %}
            <h3 style="margin-bottom: 10px;">
                {{ $t('kommandhub-paystack-detail.grid.captures') }}
            </h3>
            <sw-data-grid
                    :data-source="paystackCaptures"
                    :columns="paystackCaptureColumns"
                    :show-selection="false"
                    :show-actions="true"
                    class="kommandhub-paystack-detail-captures-grid"
            >
                <template #column-amount="{ item }">
                    {{ currencyFilter(item.amount.totalPrice, paystackTransaction.customFields.paystack_currency) }}
                </template>

                <template #column-state="{ item }">
                    <sw-label
                            v-if="item.stateMachineState"
                            variant="neutral"
                            appearance="pill"
                    >
                        {{ item.stateMachineState.translated.name }}
                    </sw-label>
                </template>

                <template #column-createdAt="{ item }">
                    <sw-time-ago
                            :date="item.createdAt"
                            :date-time-format="{ month: '2-digit', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }"
                    />
                </template>

                <template #actions="{ item }">
                    <sw-context-menu-item
                            v-if="item.refunds && item.refunds.length"
                            @click="onOpenRefundsListModal(item)"
                    >
                        {{ $t('kommandhub-paystack-detail.grid.refunds') }}
                    </sw-context-menu-item>
                </template>
            </sw-data-grid>
            {% endblock %}
        </template>
    </mt-card>
    {% endblock %}

    {% block kommandhub_paystack_detail_refunds_list_modal %}
    <sw-modal
            v-if="showRefundsListModal"
            :title="$t('kommandhub-paystack-detail.refund.listModalTitle')"
            @modal-close="onCloseRefundsListModal"
    >
        {% block kommandhub_paystack_detail_refunds_list_grid %}
        <sw-data-grid
                :data-source="paystackRefunds"
                :columns="paystackRefundColumns"
                :show-selection="false"
                :show-actions="false"
                class="kommandhub-paystack-detail-refunds-grid"
        >
            <template #column-amount="{ item }">
                {{ currencyFilter(item.amount.totalPrice, paystackTransaction.customFields.paystack_currency) }}
            </template>

            <template #column-state="{ item }">
                <sw-label
                        v-if="item.stateMachineState"
                        variant="neutral"
                        appearance="pill"
                >
                    {{ item.stateMachineState.translated.name }}
                </sw-label>
            </template>

            <template #column-createdAt="{ item }">
                <sw-time-ago
                        :date="item.createdAt"
                        :date-time-format="{ month: '2-digit', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }"
                />
            </template>
        </sw-data-grid>
        {% endblock %}

        {% block kommandhub_paystack_detail_refunds_list_modal_footer %}
        <template #modal-footer>
            <mt-button
                    variant="secondary"
                    size="small"
                    @click="onCloseRefundsListModal"
            >
                {{ $t('global.default.close') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}

    {% block kommandhub_paystack_detail_refund_modal %}
    <sw-modal
            v-if="showRefundModal"
            :title="$t('kommandhub-paystack-detail.refund.modalTitle')"
            @modal-close="onCloseRefundModal"
    >
        {% block kommandhub_paystack_detail_refund_modal_content %}
        <sw-container
                columns="1fr 1fr"
                gap="16px"
        >
            <sw-number-field
                    v-model="refundAmount"
                    :label="$t('kommandhub-paystack-detail.refund.amountLabel')"
                    :placeholder="$t('kommandhub-paystack-detail.refund.amountPlaceholder')"
                    :help-text="$t('kommandhub-paystack-detail.refund.amountHelpText')"
                    number-type="float"
                    :min="0.01"
            />

            <sw-text-field
                    v-model="refundCurrency"
                    :label="$t('kommandhub-paystack-detail.refund.currencyLabel')"
                    disabled
            />
        </sw-container>

        <sw-text-field
                v-model="customerNote"
                :label="$t('kommandhub-paystack-detail.refund.customerNoteLabel')"
                :placeholder="$t('kommandhub-paystack-detail.refund.customerNotePlaceholder')"
        />

        <sw-text-field
                v-model="merchantNote"
                :label="$t('kommandhub-paystack-detail.refund.merchantNoteLabel')"
                :placeholder="$t('kommandhub-paystack-detail.refund.merchantNotePlaceholder')"
        />
        {% endblock %}

        {% block kommandhub_paystack_detail_refund_modal_footer %}
        <template #modal-footer>
            <mt-button
                    variant="secondary"
                    size="small"
                    @click="onCloseRefundModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>

            <sw-button-process
                    variant="primary"
                    size="small"
                    :isLoading="isRefundLoading"
                    :processSuccess="isRefundSuccess"
                    @process-finish="onRefundFinished"
                    @click="onConfirmRefund"
            >
                {{ $t('kommandhub-paystack-detail.refund.confirmButton') }}
            </sw-button-process>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}
{% endblock %}